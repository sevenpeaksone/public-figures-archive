{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Figure Event",
  "type": "object",
  "required": [
    "person_id",
    "event_date",
    "observed_at",
    "source_name",
    "source_url",
    "source_grade",
    "event_type",
    "title",
    "summary",
    "dedupe_key"
  ],
  "properties": {
    "person_id": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "event_type": {
      "enum": [
        "statement",
        "schedule",
        "business",
        "policy",
        "legal",
        "product",
        "market",
        "social_post",
        "other"
      ]
    },
    "topic_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "direct_quote": {
      "type": "string"
    },
    "reported_statement": {
      "type": "string"
    },
    "stance_or_claim": {
      "type": "string"
    },
    "impact_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dedupe_key": {
      "type": "string"
    }
  }
}
